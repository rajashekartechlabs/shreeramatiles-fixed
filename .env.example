# Google Sheets Integration Configuration (Placeholders)
# Copy these into your .env.local for local testing or into Vercel Project Settings for production.

# 1. Google Cloud Service Account Client Email
GOOGLE_SHEETS_CLIENT_EMAIL=PLACEHOLDER_service_account_email@your-gcp-project.iam.gserviceaccount.com

# 2. Google Cloud Service Account Private Key (keep quotes and \n if single line)
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# 3. Google Sheet ID (from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=PLACEHOLDER_GOOGLE_SHEET_ID

# 4. Sheet tab name and column range (default: Products!A2:E)
GOOGLE_SHEET_RANGE=Products!A2:E
